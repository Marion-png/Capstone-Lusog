APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This project runs against the deployed Railway PostgreSQL in the workspace
# "Gabriel Angelo Casana's Projects" - not a local server. Paste that Postgres
# service's DATABASE_PUBLIC_URL (Railway -> the project -> Postgres -> Variables)
# into DB_URL; it wins over the split-out fields below.
# See docs/railway-database-access.md.
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=prefer

# Alternative to DB_URL: fill these in and leave DB_URL empty.
DB_HOST=
DB_PORT=5432
DB_DATABASE=railway
DB_USERNAME=postgres
DB_PASSWORD=

# Reuse the database connection between requests. Worth it against a remote
# or tunnelled database, where opening one costs several round trips; leave it
# off against a local server.
DB_PERSISTENT=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Claude vision — reads a photographed feeding-attendance sheet against the
# known roster. Leave blank to disable photo scanning; the CSV/XLSX import
# keeps working either way. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Gemini vision — reads a photographed or scanned CLASS MASTERLIST on the class
# adviser's Enroll Student panel. Leave blank to disable masterlist scanning;
# the CSV/XLSX import keeps working either way. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# At-risk beneficiary rule. Modes: attendance_rate | consecutive_absences.
# The threshold here is the default for schools that have not set their own —
# the System Admin can override it per school. Changing these re-flags learners
# on the next import — see config/feeding.php.
FEEDING_AT_RISK_MODE=attendance_rate
FEEDING_AT_RISK_THRESHOLD_PERCENT=80
FEEDING_AT_RISK_CONSECUTIVE_ABSENCES=3

# Scanned photos are deleted once every mark on them has been confirmed.
FEEDING_SCAN_ENABLED=true
FEEDING_SCAN_MAX_UPLOAD_KB=10240
FEEDING_SCAN_PURGE_AFTER_REVIEW=true
