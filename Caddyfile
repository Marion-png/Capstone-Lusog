# The deployed web server (docs/deployment.md). Railpack serves the app with
# FrankenPHP and uses a Caddyfile at the repository root in place of its own
# (railpack: core/providers/php/Caddyfile); this one is that default plus the
# rules commented below. Railpack renders it as a Go template, which is where
# the {{.RAILPACK_PHP_ROOT_DIR}} root comes from (/app/public for Laravel).
# Local development never reads it.
{
	admin off
	persist_config off
	auto_https off

	{$CADDY_GLOBAL_OPTIONS}

	# Railpack's default is DEBUG, which writes three lines for every request,
	# asset fetches included. Laravel writes its own errors to stderr, and
	# Railway keeps the HTTP log separately.
	log {
		format json
		output stderr
		level INFO
	}

	frankenphp {
		# No "X-Powered-By: PHP/8.x" telling every visitor the exact version.
		php_ini expose_php Off
		# The code in the container never changes after the build, so opcache
		# need not check every file's timestamp on every request.
		php_ini opcache.validate_timestamps 0

		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {
	root * {{.RAILPACK_PHP_ROOT_DIR}}

	encode zstd br gzip

	# The front controller is the only script that runs. A debug file left in
	# public/ (a phpinfo() page once was, and printed every secret in the
	# environment) is answered 404 instead of executed — including through a
	# path-info URL such as /debug.php/anything, which PHP would still run.
	@scripts {
		path *.php *.php/*
		not path /index.php /index.php/*
	}
	respond @scripts 404

	# Nothing whose name starts with a dot (.htaccess, .env, .git), and not
	# the Vite manifest, which maps the source tree and no page reads.
	@hidden path */.* /build/manifest.json
	respond @hidden 404

	header {
		-X-Powered-By
		X-Content-Type-Options nosniff
	}

	# Vite fingerprints every build file, so a changed file is a new URL.
	header /build/assets/* Cache-Control "public, max-age=31536000, immutable"
	# The logos load on every page; a school replacing one redeploys anyway.
	header /images/* Cache-Control "public, max-age=604800"

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
